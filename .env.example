# Shmicroinvest Shmelta Pro – server settings.
# Copy to .env (development: apps/server/.env is read by `pnpm dev`) or set them in your host.
# Every variable is optional unless marked REQUIRED.

# --- Runtime -----------------------------------------------------------------
# production turns on: setup token for the first company, refusal to start without
# a persistent secret, short error logs. Always set it on a public server.
NODE_ENV=production
# Port and interface of the HTTP server (default 3000 on 0.0.0.0).
PORT=3000
HOST=0.0.0.0
# 1 when a reverse proxy (Caddy, nginx, a PaaS router) terminates HTTPS in front of the
# server: X-Forwarded-Proto marks the session cookie Secure and enables HSTS, and the
# last X-Forwarded-For entry is the client IP for login limiting. Leave 0 without a proxy
# (otherwise clients could fake their address).
TRUST_PROXY=0

# --- Data --------------------------------------------------------------------
# Either a Postgres server (one database per company plus this catalog database; the role
# needs CREATEDB) ...
# DATABASE_URL=postgres://shmelta:change-me@db:5432/shmelta?sslmode=disable
# ... or the embedded PGlite database in a directory (default apps/server/.data, or data/
# next to server.js in the release bundle). Must be persistent storage.
DATA_DIR=/var/lib/shmelta
# Connections per company database in Postgres mode (default 5).
# PG_POOL_MAX=5
# PGPASSWORD is honoured by the Postgres client when the URL has no password.

# --- Secrets -----------------------------------------------------------------
# Key that encrypts stored SMTP passwords. In production one of these is REQUIRED and
# must survive restarts and redeploys: SHMI_SECRET (any long random string), or a key
# file SHMI_SECRET_FILE (created on first start, default <DATA_DIR>/secret.key).
# SHMI_SECRET=
# SHMI_SECRET_FILE=/var/lib/shmelta/secret.key
# Token needed to create the first company and administrator. In production without it
# a random token is generated and printed in the server log at start.
# SHMI_SETUP_TOKEN=

# --- Sessions and limits ------------------------------------------------------
# A session ends after this many idle minutes (default 720 = 12 h) ...
# SESSION_IDLE_MINUTES=720
# ... and at the latest this many days after the login (default 14).
# SESSION_MAX_AGE_DAYS=14
# Failed logins / setup tokens allowed per client IP within the window (default 20 in 15 min).
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_IP_WINDOW_MINUTES=15
# Request body limits in MB: ordinary requests (default 4) and file uploads – imports,
# bank statements, backups, attachments (default 100).
# MAX_JSON_BODY_MB=4
# MAX_UPLOAD_MB=100

# --- Logs, mail, services ------------------------------------------------------
# Application log file ("Дневник на приложението"). Default <DATA_DIR>/shmelta.log with
# PGlite; with Postgres there is no file unless this is set.
# APP_LOG=/var/lib/shmelta/shmelta.log
# json = do not send e-mail, only log it (tests, demos). Unset = the company's SMTP settings.
# MAIL_TRANSPORT=json
# Time zone of the working date and of printed times (default Europe/Sofia).
# TZ_COMPANY=Europe/Sofia
# EU VIES VAT-number check and ECB exchange rates (defaults are the official endpoints).
# VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number
# ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-hist-90d.xml
# Serve the UI from another folder (default: web/ in the bundle, apps/web/dist from source).
# WEB_DIST=

# --- Off-site backups (S3-compatible storage) ----------------------------------
# With a bucket set, every company is backed up on the schedule as a ZIP of its backup
# file, "Архивиране на фирма" offers to upload the new archive, and administrators can
# restore a remote archive in "Възстановяване на фирма". Works with AWS S3, Hetzner,
# Backblaze B2, MinIO, Garage, SeaweedFS (SigV4).
# SHMI_BACKUP_S3_BUCKET=shmelta-backups
# SHMI_BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# SHMI_BACKUP_S3_REGION=us-east-1
# SHMI_BACKUP_S3_ACCESS_KEY=
# SHMI_BACKUP_S3_SECRET_KEY=
# SHMI_BACKUP_S3_SECRET_KEY_FILE=/run/secrets/s3_secret
# true/false; default path-style except on *.amazonaws.com.
# SHMI_BACKUP_S3_PATH_STYLE=true
# Key prefix; archives go to <prefix><database>/<file>.zip (default shmelta/).
# SHMI_BACKUP_PREFIX=shmelta/
# "daily 02:00" (default, TZ_COMPANY), several times "02:00,14:00", or "off".
# SHMI_BACKUP_SCHEDULE=daily 02:00
# Archives kept per company after each upload (default 14).
# SHMI_BACKUP_KEEP=14
# Password of the uploaded ZIPs (a user's own ZIP password is used for the uploads that user starts).
# SHMI_BACKUP_ZIP_PASSWORD=
# Timeout of one storage request in ms (default 60000).
# SHMI_BACKUP_TIMEOUT_MS=60000

# deploy/.env for docker compose (copy to .env and fill in). Never commit the real file.

# Public host name; DNS A/AAAA records must point at this server. localhost = local test.
DOMAIN=shmelta.example.bg
# Host ports of Caddy (keep 80/443 for automatic certificates).
# HTTP_PORT=80
# HTTPS_PORT=443

# Postgres superuser (backups and restores only) and the app's own role.
POSTGRES_PASSWORD=change-me-long-random
APP_DB_PASSWORD=change-me-long-random-too

# Encrypts stored SMTP passwords; keep it with your backups (without it they cannot be read).
# Generate: openssl rand -base64 32
SHMI_SECRET=change-me

# Needed once, to create the first company. Unset = a random token is printed in
# `docker compose logs app` at start.
SHMI_SETUP_TOKEN=

# Daily backups of every database (deploy/backups unless BACKUP_HOST_DIR is set).
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
# BACKUP_HOST_DIR=/srv/shmelta-backups

# Image tag built by `docker compose build`.
SHMELTA_VERSION=1.0.0
